# Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ─── Database ─────────────────────────────────────────────────────────────────
# LOCAL DEV: use DATABASE_URL (Docker PostgreSQL — run `make db-up`)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/landing

# PRODUCTION (Supabase): leave DATABASE_URL empty and fill these instead
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── App ──────────────────────────────────────────────────────────────────────
# WhatsApp number in international format without + (e.g. 5491112345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Pre-filled message that opens in the WhatsApp chat (optional)
NEXT_PUBLIC_WHATSAPP_MESSAGE=¡Hola! Me gustaría obtener más información.

# Email address to receive contact form notifications
CONTACT_EMAIL_TO=

# ─── Maintenance Mode ─────────────────────────────────────────────────────────
# Enable password-protected maintenance page (true/false)
MAINTENANCE_MODE_ENABLED=false

# Preferred: password hash (supports sha256:<hex> or scrypt:<salt_hex>:<hash_hex>)
# If this is set, MAINTENANCE_PASSWORD is ignored.
MAINTENANCE_PASSWORD_HASH=

# Optional fallback plain-text password (use only if MAINTENANCE_PASSWORD_HASH is not set)
MAINTENANCE_PASSWORD=

# Required secret for signing the maintenance auth cookie (use a long random value)
MAINTENANCE_COOKIE_SECRET=

# Optional cookie settings
MAINTENANCE_COOKIE_NAME=maintenance_auth
MAINTENANCE_COOKIE_TTL_SECONDS=28800

# Brute-force protection for /api/maintenance/unlock
MAINTENANCE_MAX_ATTEMPTS=5
MAINTENANCE_ATTEMPT_WINDOW_SECONDS=900
MAINTENANCE_LOCKOUT_SECONDS=900

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Resend API key for email notifications
RESEND_API_KEY=

# Verified sender email for Resend (must match a domain verified in your Resend account)
# Defaults to onboarding@resend.dev for development
RESEND_FROM_EMAIL=

# Destination email for inbound forwarding (emails received at your domain get forwarded here)
INBOUND_FORWARD_TO=
