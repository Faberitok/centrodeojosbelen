# Centro de Ojos Belén — Variables de entorno
# Copiá este archivo a .env.local y completá los valores.
# NUNCA commitear .env.local.

# ─── App ──────────────────────────────────────────────────────────────────────
# URL pública del sitio (sin barra final). Se usa en canonical, sitemap, robots y OG.
NEXT_PUBLIC_SITE_URL=https://www.centrodeojosbelen.com.ar

# ─── WhatsApp (chatbot del centro) ────────────────────────────────────────────
# Número en formato internacional sin + ni espacios (ej: 5493834123456)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Mensaje precargado al abrir el chat. Debe ser el saludo que espera el chatbot.
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hola, quisiera hacer una consulta.

# ─── Correo (Resend) ──────────────────────────────────────────────────────────
# API key de Resend
RESEND_API_KEY=

# Remitente técnico. El dominio debe estar verificado en Resend (SPF + DKIM).
RESEND_FROM_EMAIL=web@centrodeojosbelen.com.ar

# Casilla del centro que recibe las consultas del formulario
CONTACT_EMAIL_TO=contacto@centrodeojosbelen.com.ar

# Casilla a la que se reenvía el correo entrante del dominio (Resend Inbound)
INBOUND_FORWARD_TO=

# ─── Modo mantenimiento / página en construcción ──────────────────────────────
# true = el sitio muestra la página en construcción a todos menos a quien tenga la contraseña
MAINTENANCE_MODE_ENABLED=false

# Usuario de acceso del equipo
MAINTENANCE_USER=

# Preferido: hash de la contraseña (sha256:<hex> o scrypt:<salt_hex>:<hash_hex>).
# Generar con:
#   node -e "console.log('sha256:'+require('crypto').createHash('sha256').update('TU-CONTRASEÑA').digest('hex'))"
# Si está definido, MAINTENANCE_PASSWORD se ignora.
MAINTENANCE_PASSWORD_HASH=

# Fallback en texto plano (usar solo si no hay MAINTENANCE_PASSWORD_HASH)
MAINTENANCE_PASSWORD=

# Secreto para firmar la cookie de acceso (valor largo y aleatorio)
MAINTENANCE_COOKIE_SECRET=

# Opcionales
MAINTENANCE_COOKIE_NAME=maintenance_auth
MAINTENANCE_COOKIE_TTL_SECONDS=28800

# Protección de fuerza bruta en /api/maintenance/unlock
MAINTENANCE_MAX_ATTEMPTS=5
MAINTENANCE_ATTEMPT_WINDOW_SECONDS=900
MAINTENANCE_LOCKOUT_SECONDS=900
